---
export interface Question { q: string; a: string }
interface Props { items: Question[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((item) => (
    <details>
      <summary><h3>{item.q}</h3></summary>
      <p>{item.a}</p>
    </details>
  ))}
</div>
<style>
  .faq { display: grid; gap: 0.75rem; }
  details { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  details[open] { border-color: #a9cdbd; box-shadow: var(--shadow-s); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 56px; padding: 0.9rem 1.25rem; cursor: pointer; list-style: none; border-radius: var(--radius); }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; flex: none; font-size: 1.5rem; line-height: 1; color: var(--green); transition: transform 0.2s ease; }
  details[open] summary::after { transform: rotate(45deg); }
  h3 { font-size: 1.02rem; margin: 0; line-height: 1.4; }
  p { margin: 0; padding: 0 1.25rem 1.25rem; color: var(--ink-soft); }
</style>
