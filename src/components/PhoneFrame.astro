---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; eager?: boolean; class?: string }
const { src, alt, eager = false, class: className } = Astro.props;
---
<div class:list={['phone', className]}>
  <Image src={src} alt={alt} width={360} widths={[240, 360, 540, 720]} sizes="(max-width: 600px) 70vw, 300px" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
</div>
<style>
  .phone { width: 100%; max-width: 300px; padding: 8px; background: #0a1116; border-radius: 13% / 6%; box-shadow: var(--shadow-l), inset 0 0 0 1px rgb(255 255 255 / 0.18); }
  .phone :global(img) { width: 100%; border-radius: 11.5% / 5.3%; aspect-ratio: 1206 / 2622; }
</style>
