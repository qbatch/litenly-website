---
import { Image } from 'astro:assets';
import Container from './Container.astro';
import Button from './Button.astro';
import mark from '../assets/litenly-mark.png';
import { site, withBase } from '../data/site';
---
<section class="section">
  <Container>
    <div class="cta">
      <Image src={mark} alt="" width={88} height={88} densities={[1, 2, 3]} />
      <h2>Make room without guessing</h2>
      <p>See the measured size and compare the picture before you save it.</p>
      <div class="actions">
        {site.appStoreUrl
          ? <Button href={site.appStoreUrl} variant="light">Download on the App Store</Button>
          : <Button href={withBase('/support')} variant="light">Read the usage guide</Button>}
        <Button href={withBase('/privacy-policy')} variant="ghost-light">How your data is handled</Button>
      </div>
      {!site.appStoreUrl && <p class="note">The App Store link will appear here once Litenly is listed.</p>}
    </div>
  </Container>
</section>
<style>
  .cta { display: flex; flex-direction: column; align-items: center; text-align: center; color: #fff; background: radial-gradient(70% 100% at 100% 0%, rgb(110 90 255 / 0.4), transparent 65%), var(--brand); border-radius: var(--radius-l); padding: clamp(2.5rem, 6vw, 4.5rem) 1.5rem; }
  .cta :global(img) { margin-bottom: 1.5rem; filter: drop-shadow(0 12px 20px rgb(0 0 0 / 0.3)); }
  p { color: #dcebf0; max-width: 34rem; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 1rem; }
  .note { font-size: 0.875rem; margin: 1.5rem 0 0; }
</style>
