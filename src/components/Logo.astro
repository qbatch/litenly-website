---
import { Image } from 'astro:assets';
import mark from '../assets/litenly-mark.png';
import { site } from '../data/site';
interface Props { size?: number }
const { size = 36 } = Astro.props;
---
<a class="logo" href="/">
  <Image src={mark} alt="" width={size} height={size} densities={[1, 2, 3]} loading="eager" />
  <span>{site.name}</span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 44px; font-weight: 800; font-size: 1.25rem; letter-spacing: -0.02em; color: inherit; text-decoration: none; }
  .logo:hover { color: inherit; }
</style>
