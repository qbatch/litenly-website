---
import MainLayout from '../layouts/MainLayout.astro';
import Container from '../components/Container.astro';
import Hero from '../components/Hero.astro';
import FeatureCard from '../components/FeatureCard.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import editorShot from '../assets/screens/editor.png';
import reviewShot from '../assets/screens/review.png';
import compareShot from '../assets/screens/compare.png';
import galleryShot from '../assets/screens/gallery.png';
import pdfShot from '../assets/screens/pdf.png';
import imagesPdfShot from '../assets/screens/images-pdf.png';
import { site, withBase } from '../data/site';

const features: { icon: IconName; title: string; text: string }[] = [
  { icon: 'target', title: 'Maximum file size first', text: 'Start with a maximum file size, with a recommended value already suggested. Quality stays within it.' },
  { icon: 'gauge', title: 'Quality you control', text: 'Choose Gentle, Balanced or Smallest, or fine-tune with the slider. Balanced is the default.' },
  { icon: 'compare', title: 'Compare the result', text: 'The result screen puts the original and the compressed photo side by side.' },
  { icon: 'crop', title: 'Resize and crop', text: 'Keep the original dimensions, fit within a size, or set exact dimensions with crop options.' },
  { icon: 'file', title: 'Smaller PDFs', text: 'Selectable text is kept where rewriting the document makes it smaller.' },
  { icon: 'file', title: 'Images to PDF and back', text: 'Put up to 30 pictures into one PDF, or turn PDF pages into JPEG, PNG or HEIC files.' },
  { icon: 'grid', title: 'Smart Gallery', text: 'Choose photos or scan your full gallery. Scanning changes nothing.' },
  { icon: 'history', title: 'History', text: 'Look back at your recent compressions, and use Clear All Data when you want a fresh start.' },
  { icon: 'bell', title: 'Reminders and alerts', text: 'Turn on optional reminders or a low-storage alert. Both are local notifications.' },
];

const steps = [
  { title: 'Set a maximum size', text: 'Choose a photo, then accept the recommended maximum or enter your own. Adjust quality, dimensions or format if you need to.', shot: editorShot, alt: 'Edit Image screen with the maximum file size set to the recommended 1.00 MB and a new size of 932 KB' },
  { title: 'Choose how to save', text: 'For a library photo, pick Compressed copy or Replace original before compression starts.', shot: reviewShot, alt: 'Review screen offering Compressed copy or Replace original above the Start compression button' },
  { title: 'Compare the result', text: 'Check the compressed photo against the original on the result screen.', shot: compareShot, alt: 'Result screen with a slider comparing the original and compressed photo of pink flowers' },
];

// Shown around one screenshot: the first three sit on its left, the rest on its right.
const callouts: { icon: IconName; title: string; text: string }[] = [
  { icon: 'grid', title: 'Pick what to scan', text: 'Your full gallery, or only the photos you choose.' },
  { icon: 'shield', title: 'Scanning changes nothing', text: 'Your library stays as it is while Litenly looks.' },
  { icon: 'gauge', title: 'See the possible saving', text: 'Eligible photos, total size and an estimate.' },
  { icon: 'target', title: 'Set your plan', text: 'Choose a saving goal, quality and method.' },
  { icon: 'check', title: 'Review every photo', text: 'Include or skip any of them before you start.' },
  { icon: 'compare', title: 'Compress them together', text: 'Follow saved, skipped and failed counts.' },
];

const benefits = [
  { title: 'Nothing is uploaded', text: 'There is no account, no ads, no analytics and no upload step.' },
  { title: 'Your original is removed only if you choose it', text: 'It goes only when you ask for that and approve Apple’s prompt. Deleted items go to Recently Deleted.' },
  { title: 'Never a bigger photo', text: 'A compressed photo is never bigger than the original, and a size limit does not lower resolution on its own.' },
  { title: 'You approve every removal', text: 'In Smart Gallery, originals are removed only after you review them, confirm, and approve Apple’s prompt.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: site.fullName,
  operatingSystem: 'iOS 17 or later',
  applicationCategory: 'UtilitiesApplication',
  description: site.description,
};
---
<MainLayout title="Litenly: Photo Compressor for iPhone" description={site.description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <Hero />

  <section class="section" id="features">
    <Container>
      <div class="section-head">
        <span class="eyebrow">Features</span>
        <h2>Everything you need to slim a file</h2>
        <p>For a single photo, a PDF or a crowded library.</p>
      </div>
      <div class="features">
        {features.map((f) => <FeatureCard icon={f.icon} title={f.title}>{f.text}</FeatureCard>)}
      </div>
    </Container>
  </section>

  <section class="section alt" id="how-it-works">
    <Container>
      <div class="section-head">
        <span class="eyebrow">How it works</span>
        <h2>Three steps to a smaller file</h2>
        <p>From a photo to a smaller file. No sign-up.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="num" aria-hidden="true">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <PhoneFrame src={s.shot} alt={s.alt} />
          </li>
        ))}
      </ol>
    </Container>
  </section>

  <section class="section" id="pdf">
    <Container class="showcase">
      <div>
        <span class="eyebrow">PDF tools</span>
        <h2>Shrink, convert and build PDFs</h2>
        <ul class="checks">
          <li><Icon name="check" /><span><strong>Compress a PDF.</strong> Documents with selectable text keep it where that makes them smaller. Scanned documents, and those a rewrite cannot shrink, become page pictures without selectable text.</span></li>
          <li><Icon name="check" /><span><strong>PDF to images.</strong> Export all pages or a range as JPEG, PNG or HEIC, one file per page.</span></li>
          <li><Icon name="check" /><span><strong>Images to PDF.</strong> Reorder up to 30 pictures and choose Fit image, A4 or US Letter pages.</span></li>
        </ul>
        <p><a href={withBase('/support#pdf-guide')}>Read the PDF guide</a></p>
      </div>
      <div class="shot pair">
        <PhoneFrame src={pdfShot} alt="PDF result screen showing a document reduced from 8.3 MB to 4.1 MB with its text kept" />
        <PhoneFrame src={imagesPdfShot} alt="Images to PDF screen with four pictures that can be reordered" />
      </div>
    </Container>
  </section>

  <section class="section alt" id="smart-gallery">
    <Container>
      <div class="section-head">
        <span class="eyebrow">Smart Gallery</span>
        <h2>Compress your whole gallery in one run</h2>
        <p>Scan, choose a plan, review, and compress many photos together. Scanning changes nothing.</p>
      </div>
      <div class="scan">
        {[callouts.slice(0, 3), callouts.slice(3)].map((side, s) => (
          <ol class:list={['callouts', s ? 'right' : 'left']} start={s * 3 + 1}>
            {side.map((c) => (
              <li>
                <Icon name={c.icon} />
                <div><h3>{c.title}</h3><p>{c.text}</p></div>
              </li>
            ))}
          </ol>
        ))}
        <PhoneFrame src={galleryShot} alt="Smart Gallery Scan Summary showing 8 eligible photos and an estimated saving of about 12.2 MB" />
      </div>
      <div class="after">
        <h3>Your originals, your decision</h3>
        <ul class="checks">
          <li><Icon name="check" /><span><strong>Create Compressed Copies.</strong> Smaller copies are added to your library and your originals are not changed.</span></li>
          <li><Icon name="check" /><span><strong>Compress in Place.</strong> Smaller replacements are saved, and you decide whether the originals go.</span></li>
          <li><Icon name="check" /><span><strong>Three quality levels.</strong> Gentle, Balanced or Aggressive.</span></li>
          <li><Icon name="check" /><span><strong>Stay in control.</strong> Originals are removed only after review, confirmation and Apple’s own prompt.</span></li>
        </ul>
        <p>Live Photos are not processed, and the scan does not download originals that are only in iCloud.</p>
        <p><a href={withBase('/support#smart-gallery-guide')}>Read the Smart Gallery guide</a></p>
      </div>
    </Container>
  </section>

  <section class="section" id="why">
    <Container>
      <div class="section-head">
        <span class="eyebrow">Why Litenly</span>
        <h2>Careful with your files by design</h2>
      </div>
      <div class="benefits">
        {benefits.map((b) => (
          <div>
            <Icon name="shield" size={26} />
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <CTA />
</MainLayout>

<style>
  .alt { background: var(--surface); border-block: 1px solid var(--line); }
  .features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; list-style: none; margin: 0; padding: 0; }
  .steps li { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .steps p { color: var(--ink-soft); max-width: 32ch; flex: 1; }
  .steps li :global(.phone) { max-width: 260px; margin-top: 1rem; }
  .num { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--brand); color: #fff; font-weight: 800; margin-bottom: 1rem; }
  section :global(.showcase) { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 4rem; align-items: center; }
  .after { max-width: 640px; margin: 3.5rem auto 0; }
  .scan { display: grid; grid-template-columns: 1fr minmax(0, 300px) 1fr; grid-template-areas: 'left phone right'; gap: 2.5rem; align-items: center; }
  .scan > :global(.phone) { grid-area: phone; }
  .callouts { list-style: none; margin: 0; padding: 0; display: grid; gap: 3.5rem; }
  .callouts.left { grid-area: left; }
  .callouts.right { grid-area: right; }
  .callouts li { position: relative; display: flex; gap: 0.85rem; padding: 1.1rem 1.25rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: 0 18px 36px -20px rgb(8 20 50 / 0.35); }
  /* The pointer that ties each message to the screenshot. */
  .callouts li::after { content: ''; position: absolute; top: 50%; width: 14px; height: 14px; background: var(--surface); border: solid var(--line); transform: translateY(-50%) rotate(45deg); }
  .left li::after { right: -8px; border-width: 1px 1px 0 0; }
  .right li::after { left: -8px; border-width: 0 0 1px 1px; }
  .callouts :global(svg) { flex: none; color: var(--green); margin-top: 2px; }
  .callouts h3 { font-size: 1.05rem; margin-bottom: 0.25rem; }
  .callouts p { color: var(--ink-soft); font-size: 0.925rem; line-height: 1.5; margin: 0; }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .callouts li { animation: pop linear both; animation-timeline: view(); animation-range: entry 10% entry 100%; }
    }
  }
  @keyframes pop { from { opacity: 0; scale: 0.7; } to { opacity: 1; scale: 1; } }
  .checks { list-style: none; padding: 0; margin: 1.75rem 0; display: grid; gap: 1rem; }
  .checks li { display: flex; gap: 0.75rem; align-items: flex-start; }
  .checks :global(svg) { flex: none; color: var(--green); margin-top: 2px; }
  .shot { display: flex; justify-content: center; padding: 3rem 1.5rem; border-radius: var(--radius-l); background: var(--brand); }
  .pair { gap: 1rem; align-items: center; padding-inline: 1rem; }
  .pair :global(.phone) { flex: 1; min-width: 0; }
  .benefits { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2.5rem 4rem; }
  .benefits > div { border-top: 2px solid var(--line); padding-top: 1.5rem; }
  .benefits :global(svg) { color: var(--green); margin-bottom: 0.75rem; }
  .benefits p { color: var(--ink-soft); margin: 0; }
  @media (max-width: 920px) {
    .scan { grid-template-columns: 1fr; grid-template-areas: 'phone' 'left' 'right'; gap: 1rem; justify-items: center; }
    .callouts { gap: 1rem; width: min(100%, 460px); }
    .callouts li::after { display: none; }
    .features { grid-template-columns: repeat(2, 1fr); }
    .steps { grid-template-columns: 1fr; gap: 4rem; }
    section :global(.showcase) { grid-template-columns: 1fr; gap: 2rem; }
  }
  @media (max-width: 620px) {
    .features, .benefits { grid-template-columns: 1fr; }
    .benefits { gap: 1.75rem; }
  }
</style>
