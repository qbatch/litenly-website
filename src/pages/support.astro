---
import MainLayout from '../layouts/MainLayout.astro';
import Container from '../components/Container.astro';
import PageHeader from '../components/PageHeader.astro';
import FAQ, { type Question } from '../components/FAQ.astro';
import { withBase } from '../data/site';

const topics = [
  { href: '#getting-started', label: 'Getting started' },
  { href: '#pdf-guide', label: 'PDF' },
  { href: '#smart-gallery-guide', label: 'Smart Gallery' },
  { href: '#troubleshooting', label: 'Troubleshooting' },
  { href: '#faq', label: 'FAQ' },
];

const troubleshooting: Question[] = [
  { q: 'The size limit could not be met', a: 'A size limit does not lower resolution on its own. Raise the maximum, or choose smaller dimensions or another format.' },
  { q: 'My PDF could not be made smaller', a: 'Some files cannot be made smaller. Quality and maximum size options appear only when they change the result.' },
  { q: 'My PDF will not open', a: 'Password-protected and damaged files are not supported, and a document can have at most 300 pages.' },
  { q: 'I cannot select text in my compressed PDF', a: 'Scanned documents, and documents a rewrite cannot shrink, are turned into page pictures. Their text is not selectable. Keep the original if you need it.' },
  { q: 'There is no option to delete my original', a: 'Delete options appear for photos chosen from your photo library. A photo opened from Files has none.' },
  { q: 'My result was not saved to Photos', a: 'Saving a library photo’s result needs Photos access. Check Litenly’s access in the iOS Settings app.' },
  { q: 'A photo stored in iCloud is not processed', a: 'The Smart Gallery scan does not download originals that are only in iCloud.' },
  { q: 'A reminder or storage alert did not arrive', a: 'Check that you turned it on in Litenly and that notifications are allowed for the app in iOS Settings.' },
];

const faqs: Question[] = [
  { q: 'Are my photos uploaded anywhere?', a: 'No. Litenly has no uploads. If you save or share a result to another app or cloud service, that service handles the copy you send.' },
  { q: 'Which files can I open?', a: 'JPEG, PNG and HEIC photos from Photos or Files, and PDF documents from Files.' },
  { q: 'Which formats can I export?', a: 'A photo can be exported as JPEG, PNG or HEIC. PDF pages can be exported in the same three formats. To make a PDF from pictures, use Images to PDF.' },
  { q: 'Does compressing change my original photo?', a: 'The original is removed only if you choose it, for example with Replace original, and approve Apple’s prompt. Photos opened from Files have no delete options.' },
  { q: 'Can the result be bigger than the original photo?', a: 'No. The output is never bigger than the original.' },
  { q: 'What happens to location data and other metadata?', a: 'For single photos saved to Files or shared, metadata and location are removed by default, and you can keep supported metadata. A file already within your limit may be used as it is, with its metadata. A copy saved back to your photo library from a library photo keeps the original’s date, location, favourite status and regular albums.' },
  { q: 'Do compressed PDFs keep everything?', a: 'Rewritten PDFs lose screen reader (accessibility) tags and document metadata. Keep the original if you need them.' },
  { q: 'Does Smart Gallery process videos or Live Photos?', a: 'No.' },
  { q: 'Where do deleted photos go?', a: 'To Recently Deleted in the Photos app. Nothing is deleted without your confirmation.' },
  { q: 'How do I remove the data Litenly keeps?', a: 'Open Settings in the app and choose Clear All Data. It removes history, scan results, settings, reminders and temporary files. Your photos and saved copies stay.' },
  { q: 'Which devices are supported?', a: 'iPhone with iOS 17 or later.' },
];
---
<MainLayout title="Support and FAQ | Litenly" description="Usage guides, troubleshooting and answers to common questions about compressing photos and PDFs with Litenly on iPhone.">
  <PageHeader title="How can we help?">
    <p>Guides, fixes and answers for using Litenly on your iPhone.</p>
  </PageHeader>

  <div class="section">
    <Container narrow>
      <nav class="topics" aria-label="Support topics">
        {topics.map((t) => <a href={t.href}>{t.label}</a>)}
      </nav>

      <div class="note">
        <h2>Where to find help</h2>
        <p>This page is the guide to Litenly: how to use it, what to try when something goes wrong, and answers to common questions.</p>
        <p>There is no support email or contact form at the moment.</p>
      </div>

      <section id="getting-started">
        <h2>Compress a photo</h2>
        <ol>
          <li>Tap <strong>Select Photo</strong>, or <strong>Select from Files</strong> for a JPEG, PNG or HEIC file.</li>
          <li>Set the maximum file size. A recommended value is already suggested.</li>
          <li>Optionally choose Gentle, Balanced or Smallest quality or use the slider, resize with Original, Fit within or Exact, or change the format.</li>
          <li>Tap <strong>Compress image</strong>.</li>
          <li>For a library photo, choose <strong>Compressed copy</strong> or <strong>Replace original</strong>, then start compression.</li>
          <li>Compare the result with the original.</li>
        </ol>
        <h3>Saving the result</h3>
        <ul>
          <li><strong>Compressed copy</strong> saves a copy to Photos next to your original.</li>
          <li><strong>Replace original</strong> saves the copy, then Photos asks to delete the original.</li>
          <li>Afterwards you can delete either one. Nothing is deleted without confirmation, and deleted items go to Recently Deleted.</li>
          <li>A photo opened from Files can be saved to Photos or Files, or shared.</li>
        </ul>
      </section>

      <section id="pdf-guide">
        <h2>Working with PDFs</h2>
        <h3>Compress a PDF</h3>
        <ol>
          <li>Tap <strong>Select from Files</strong> and open the PDF.</li>
          <li>Keep PDF as the output. Where they change the result, set quality and an optional maximum size.</li>
          <li>Tap <strong>Compress PDF</strong> and check the result before saving.</li>
        </ol>
        <p>Documents with selectable text are rewritten and keep their text where that makes them smaller. Scanned documents, and those a rewrite cannot shrink, are turned into page pictures, so text is then not selectable. Rewritten PDFs lose screen reader (accessibility) tags and document metadata.</p>
        <h3>Turn PDF pages into images</h3>
        <ol>
          <li>Open the PDF and choose JPEG, PNG or HEIC as the output.</li>
          <li>Choose all pages or a range such as 1-3, 5.</li>
          <li>Pick the picture size: Original page, A4 or US Letter. Maximum total size and quality are linked.</li>
          <li>Convert the pages. Each page becomes its own file.</li>
        </ol>
        <h3>Make a PDF from images</h3>
        <ol>
          <li>Tap <strong>Images to PDF</strong> and add up to 30 pictures.</li>
          <li>Put them in order.</li>
          <li>Choose Fit image, A4 or US Letter, optional margins, and either a size limit or Best quality.</li>
          <li>Create the PDF.</li>
        </ol>
      </section>

      <section id="smart-gallery-guide">
        <h2>Using Smart Gallery</h2>
        <ol>
          <li>Open <strong>Smart Gallery</strong> and tap <strong>Choose photos</strong> or <strong>Scan Full Gallery</strong>.</li>
          <li>Wait for the scan. It changes nothing.</li>
          <li>Choose <strong>Create Compressed Copies</strong> or <strong>Compress in Place</strong>, and Gentle, Balanced or Aggressive quality.</li>
          <li>Review your selection and confirm.</li>
          <li>Originals are removed only after you review them, confirm, and approve Apple’s own prompt.</li>
        </ol>
        <p>Videos and Live Photos are not processed, and the scan does not download originals that are only in iCloud.</p>
      </section>

      <section id="troubleshooting">
        <h2>Troubleshooting</h2>
        <FAQ items={troubleshooting} />
      </section>

      <section id="faq">
        <h2>Frequently asked questions</h2>
        <FAQ items={faqs} />
        <p class="more">Questions about data? Read the <a href={withBase('/privacy-policy')}>Privacy Policy</a>.</p>
      </section>
    </Container>
  </div>
</MainLayout>

<style>
  .topics { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; margin-bottom: 2.5rem; }
  .topics a { min-height: 44px; display: inline-flex; align-items: center; padding: 0 1.1rem; border-radius: 99px; background: var(--surface); border: 1px solid var(--line); font-weight: 650; font-size: 0.925rem; text-decoration: none; color: var(--ink); }
  .topics a:hover { border-color: var(--green); color: var(--green); }
  .note { background: var(--green-tint); border-radius: var(--radius); padding: 1.5rem; }
  .note h2 { font-size: 1.25rem; }
  .note p:last-child { margin: 0; }
  section { margin-top: 3.5rem; }
  section h2 { font-size: clamp(1.5rem, 1.3rem + 0.9vw, 1.9rem); margin-bottom: 1.25rem; }
  section h3 { margin-top: 1.75rem; }
  ol, ul { padding-left: 1.35rem; }
  li { margin-bottom: 0.5rem; }
  li::marker { color: var(--green); font-weight: 700; }
  .more { margin-top: 1.5rem; }
</style>
